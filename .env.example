# 文本模型：四段流水线、意图解析、罗盘问答
API_BASE_URL=https://your-api-base-url/v1
API_KEY=your-api-key
MODEL=your-model-name

# 识图模型：上传产品图自动识别（可选；不配置则提示“识图未配置”）
VISION_BASE_URL=https://your-vision-base-url/v1
VISION_API_KEY=your-vision-api-key
VISION_MODEL=your-vision-model-name

# 生图模型：场景图生成（可选；不配置则场景图按钮禁用）
IMAGE_BASE_URL=https://your-image-base-url/v1
IMAGE_API_KEY=your-image-api-key
IMAGE_MODEL=your-image-model-name
IMAGE_URL_PREFIX=data:image/png;base64,