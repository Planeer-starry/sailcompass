API_BASE_URL=https://your-api-base-url/v1
API_KEY=your-api-key
MODEL=your-model-name
# 识图用 vision 模型（可选；不配置则上传图片时提示"识图未配置"）
VISION_BASE_URL=https://your-vision-base-url/v1
VISION_API_KEY=your-vision-api-key
VISION_MODEL=your-vision-model-name# 场景图生成（可选；不配置则场景图卡片显示"生图未配置"，按钮禁用）
# IMAGE_URL_PREFIX 仅用于 b64 通道拼 data URL，默认 data:image/png;base64,
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_URL_PREFIX=data:image/png;base64,